<IfModule mod_rewrite.c>
    RewriteEngine On

    # Internal code is included by PHP, never requested directly.
    RewriteRule ^(?:app|language|audit)(?:/|$) - [F,L,NC]
    RewriteRule ^_(?:sess_build|layout_probe)\.php$ - [F,L,NC]

    # Do not expose .env or install.lock files through the web server
    RewriteRule \.(env|lock)$ - [F,L]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    RewriteRule ^([^\.]*)$ index.php?page=$1 [L]
</IfModule>

Options -Indexes

# SVG MIME type
AddType image/svg+xml .svg

# Ensure SVG files are not blocked
<FilesMatch "\.svg$">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Allow from all
    </IfModule>
</FilesMatch>

# Additional protection for .env files
<FilesMatch "\.env$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Deny sensitive files even when mod_rewrite is unavailable.
<FilesMatch "(?i)(^\.env(?:\..*)?$|\.(?:sql|log|lock|bak|ini)$|^_(?:sess_build|layout_probe)\.php$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
