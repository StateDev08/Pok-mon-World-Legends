# Copy this file to .env and fill in your actual credentials.
# NEVER commit .env to version control.

# Database connection
DB_HOST=localhost
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name

# SMTP / e-mail settings
SMTP_HOST=smtp.yourhost.com
SMTP_PORT=587
SMTP_MAIL=noreply@yourdomain.com
SMTP_PASS=your_smtp_password

# Team password (KEYZITAPASS): the salt used for password hashing.
# The web installer generates a random value and writes it here automatically.
# Keep it secret. Existing installations must keep the original value,
# otherwise all account passwords stop matching.
KEYZITAPASS=your_team_password

# Team security password: shared password for the staff/team area
# (page "equipe-check"). The web installer generates/accepts a value
# and writes it here automatically.
TEAM_PASSWORD=your_security_password
